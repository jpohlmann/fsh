{
  "name": "fsh",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^16.28.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:sounds": "node scripts/generate-bloop.js",
    "generate:icons": "node scripts/generate-icon.js",
    "build:wordlist": "node scripts/build-wordlist.js",
    "puzzles:upload": "node scripts/put-daily-puzzles.js",
    "server": "node server/index.js",
    "server:dev": "ADMIN_API_KEY=dev-local-key node server/index.js",
    "infra:deploy": "aws cloudformation deploy --template-file infra/ec2-micro.yaml --stack-name fsh-api --capabilities CAPABILITY_IAM --parameter-overrides KeyName=YOUR_KEY InstanceType=t4g.micro",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios --latest",
    "export:web": "expo export --platform web"
  },
  "private": true
}
